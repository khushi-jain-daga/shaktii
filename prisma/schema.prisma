generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  SECURITY_ANALYST
}

enum FileStatus {
  UPLOADED
  ENCRYPTED
  VERIFIED
  TAMPERED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  files             SecureFile[]
  auditLogs         AuditLog[]
  blockchainRecords BlockchainRecord[]
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model SecureFile {
  id                String             @id @default(cuid())
  originalName      String
  storedName        String             @unique
  mimeType          String
  size              Int
  path              String
  sha256            String
  status            FileStatus         @default(UPLOADED)
  encryptedPath     String?
  iv                String?
  authTag           String?
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  verifications     FileVerification[]
  blockchainRecords BlockchainRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model FileVerification {
  id        String     @id @default(cuid())
  fileId    String
  file      SecureFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  valid     Boolean
  hash      String
  createdAt DateTime   @default(now())
}

model BlockchainRecord {
  id            String     @id @default(cuid())
  transactionId String     @unique
  network       String     @default("SHAKTII-DEMO")
  fileHash      String
  blockNumber   Int?
  verified      Boolean    @default(true)
  fileId        String
  file          SecureFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
}

model SecurityEvent {
  id          String   @id @default(cuid())
  type        String
  severity    Severity
  description String
  resource    String?
  ipAddress   String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  resource  String?
  status    String
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
